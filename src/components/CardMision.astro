---
interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;
---

<article
  class="group relative w-full h-full rounded-2xl bg-white border border-ink-100 p-8 shadow-sm card-hover overflow-hidden"
>
  <!-- Decorative accent -->
  <div class="absolute -top-12 -right-12 w-40 h-40 rounded-full bg-sky-50 group-hover:bg-sky-100 transition-colors"></div>

  <!-- Icon -->
  <div class="relative w-14 h-14 rounded-xl bg-sky-500 flex items-center justify-center mb-6 shadow-lg shadow-sky-500/30">
    <svg viewBox="0 0 24 24" class="w-7 h-7 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2 4 6v6c0 5 3.5 9.4 8 10 4.5-.6 8-5 8-10V6l-8-4Z"/>
      <path d="m9 12 2 2 4-4"/>
    </svg>
  </div>

  <div class="relative">
    <span class="inline-block text-sky-600 text-xs font-bold uppercase tracking-[0.2em] mb-2">Nuestro propósito</span>
    <h3 class="text-2xl md:text-3xl font-bold text-ink-900 mb-4">{title}</h3>
    <p class="text-ink-600 leading-relaxed text-base md:text-lg">
      {body}
    </p>
  </div>

  <!-- Bottom bar accent -->
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-sky-400 to-sky-600 origin-left scale-x-0 group-hover:scale-x-100 transition-transform"></div>
</article>
