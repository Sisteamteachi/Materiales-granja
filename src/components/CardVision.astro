---
interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;
---

<article
  class="group relative w-full h-full rounded-2xl bg-gradient-to-br from-sky-600 to-sky-800 text-white p-8 shadow-sm card-hover overflow-hidden"
>
  <!-- Decorative accent -->
  <div class="absolute -top-12 -right-12 w-40 h-40 rounded-full bg-white/10 group-hover:bg-white/15 transition-colors"></div>
  <div class="absolute inset-0 pattern-diagonal opacity-30"></div>

  <!-- Icon -->
  <div class="relative w-14 h-14 rounded-xl bg-white/15 backdrop-blur-sm flex items-center justify-center mb-6 ring-1 ring-white/20">
    <svg viewBox="0 0 24 24" class="w-7 h-7 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="3"/>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
    </svg>
  </div>

  <div class="relative">
    <span class="inline-block text-sky-100 text-xs font-bold uppercase tracking-[0.2em] mb-2">A dónde vamos</span>
    <h3 class="text-2xl md:text-3xl font-bold text-white mb-4">{title}</h3>
    <p class="text-sky-50/90 leading-relaxed text-base md:text-lg">
      {body}
    </p>
  </div>

  <!-- Bottom bar accent -->
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-white/40 to-white/80 origin-left scale-x-0 group-hover:scale-x-100 transition-transform"></div>
</article>
