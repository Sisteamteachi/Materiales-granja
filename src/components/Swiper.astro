---
interface Props {
  img: string;
  title: string;
  text: string;
}

const { img, title, text } = Astro.props;
---

<div class="swiper-slide w-full">
  <article class="group relative overflow-hidden rounded-2xl bg-ink-100 shadow-sm aspect-[4/3]">
    <img
      src={img}
      alt={title}
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
    />

    <!-- Permanent gradient -->
    <div class="absolute inset-0 bg-gradient-to-t from-ink-900/95 via-ink-900/40 to-transparent"></div>

    <!-- Hover overlay -->
    <div class="absolute inset-0 bg-ink-900/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center p-6 text-center">
      <div class="transform translate-y-3 group-hover:translate-y-0 transition-transform duration-300">
        <h3 class="text-white text-2xl font-bold mb-2">{title}</h3>
        <p class="text-ink-200 text-sm">{text}</p>
      </div>
    </div>

    <!-- Always-visible title -->
    <div class="absolute bottom-0 left-0 right-0 p-5">
      <h3 class="text-white text-xl font-bold drop-shadow">{title}</h3>
      <p class="text-ink-200 text-sm mt-1 line-clamp-2">{text}</p>
    </div>
  </article>
</div>
