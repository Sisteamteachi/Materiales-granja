---
const links = [
  { href: "/", label: "Inicio" },
  { href: "/Servicios", label: "Servicios" },
  { href: "/ServiciosE", label: "Servicios Especiales" },
  { href: "/Objectivos", label: "Objetivos" },
  { href: "/Ubicaciones", label: "Ubicaciones" },
];

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-ink-900/85 border-b border-white/5">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded-xl bg-brand-500 flex items-center justify-center shadow-sky-glow group-hover:scale-105 transition-transform">
          <svg viewBox="0 0 24 24" class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 17h20l-2-7H4l-2 7Z"/>
            <circle cx="7" cy="19" r="2"/>
            <circle cx="17" cy="19" r="2"/>
            <path d="M12 5v5"/>
            <path d="m9 8 3-3 3 3"/>
          </svg>
        </div>
        <div class="leading-tight">
          <p class="text-white font-bold tracking-wide text-base">La Granja</p>
          <p class="text-brand-400 text-[11px] uppercase tracking-[0.18em] font-medium">Materiales & Servicios</p>
        </div>
      </a>

      <!-- Desktop links -->
      <div class="hidden lg:flex items-center gap-1">
        {links.map((l) => {
          const active = path === l.href;
          return (
            <a
              href={l.href}
              class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${
                active
                  ? "bg-brand-500 text-white shadow-sky-glow"
                  : "text-ink-200 hover:text-white hover:bg-white/5"
              }`}
            >
              {l.label}
            </a>
          );
        })}
      </div>

      <!-- CTA + mobile toggle -->
      <div class="flex items-center gap-3">
        <a href="https://wa.me/573122882455" target="_blank" rel="noopener" class="hidden md:inline-flex btn-primary text-sm !py-2.5 !px-5">
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.2-.2.3-.8 1-1 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.6-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.2-.6-.4Z"/><path d="M20.5 3.5C18.3 1.2 15.2 0 12 0 5.4 0 0 5.4 0 12c0 2.1.6 4.2 1.6 6L0 24l6.2-1.6c1.7.9 3.7 1.4 5.7 1.4h.1c6.6 0 12-5.4 12-12 0-3.2-1.2-6.2-3.5-8.3ZM12 21.8h-.1c-1.8 0-3.6-.5-5.1-1.4l-.4-.2-3.7.9 1-3.6-.2-.4C2.5 15.5 2 13.8 2 12 2 6.5 6.5 2 12 2c2.7 0 5.2 1 7.1 2.9 1.9 1.9 2.9 4.4 2.9 7.1 0 5.5-4.5 9.8-10 9.8Z"/></svg>
          Cotizar
        </a>

        <button id="mobile-menu-button" class="lg:hidden p-2 rounded-lg text-ink-200 hover:text-white hover:bg-white/5 transition-colors" aria-label="Abrir menú" aria-controls="mobile-menu" aria-expanded="false">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden hidden bg-ink-900 border-t border-white/5">
    <div class="px-4 py-3 space-y-1">
      {links.map((l) => (
        <a href={l.href} class={`block px-4 py-2.5 rounded-lg text-sm font-medium ${path === l.href ? "bg-brand-500 text-white" : "text-ink-200 hover:bg-white/5 hover:text-white"}`}>
          {l.label}
        </a>
      ))}
      <a href="https://wa.me/573122882455" target="_blank" rel="noopener" class="block mt-3 btn-primary text-sm w-full">
        Cotizar por WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
