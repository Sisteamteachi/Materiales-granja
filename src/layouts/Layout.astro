---
interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Materiales y Servicios La Granja — Maquinaria pesada, materiales pétreos y transporte para la industria de la construcción en Briceño, Antioquia.",
} = Astro.props;

import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0f1424" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen flex flex-col bg-ink-50 text-ink-800">
		<Navbar />
		<slot />
		<Footer />
	</body>
</html>
