---
import Layout from "../layouts/Layout.astro";
import Carrusel from "../components/Carrusel.astro";
import {
  title,
  text,
  Carro_tanque,
  title_Carro_tanque,
} from "../js/servicesEPages";
---

<Layout title="Servicios Especiales · Materiales La Granja">
  <!-- Page header -->
  <section class="relative bg-ink-900 text-white py-20 overflow-hidden">
    <div class="absolute inset-0 pattern-grid opacity-30"></div>
    <div class="absolute -top-24 right-0 w-96 h-96 rounded-full bg-accent-500/20 blur-3xl"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block text-accent-400 text-xs font-bold uppercase tracking-[0.25em] mb-4">
        Soluciones especializadas
      </span>
      <h1 class="text-4xl md:text-6xl font-extrabold mb-5">{title}</h1>
      <p class="text-ink-300 text-lg max-w-3xl mx-auto leading-relaxed">{text}</p>
    </div>
  </section>

  <main class="py-20 lg:py-28 bg-ink-50">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 reveal">
        <span class="inline-block text-brand-500 text-xs font-bold uppercase tracking-[0.25em] mb-3">
          {title_Carro_tanque || "Transporte"}
        </span>
        <h2 class="text-ink-900 text-3xl md:text-4xl font-extrabold">
          Carro tanque
        </h2>
      </div>
      <div class="reveal">
        <Carrusel data={Carro_tanque} client:load />
      </div>
    </section>
  </main>
</Layout>
