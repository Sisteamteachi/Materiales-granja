---
import Layout from "../layouts/Layout.astro";
import CardMap from "../components/CardMap.astro";
import { ubicacion, title } from "../js/ubicacionesPages";
---

<Layout title="Ubicaciones · Materiales La Granja">
  <!-- Page header -->
  <section class="relative bg-ink-900 text-white py-20 overflow-hidden">
    <div class="absolute inset-0 pattern-grid opacity-30"></div>
    <div class="absolute -top-24 left-1/3 w-96 h-96 rounded-full bg-accent-500/20 blur-3xl"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block text-accent-400 text-xs font-bold uppercase tracking-[0.25em] mb-4">
        Cobertura regional
      </span>
      <h1 class="text-4xl md:text-6xl font-extrabold mb-5">{title}</h1>
      <p class="text-ink-300 text-lg max-w-2xl mx-auto">
        Operamos en Briceño y municipios aledaños del Norte antioqueño.
      </p>
    </div>
  </section>

  <main class="py-20 lg:py-28 bg-ink-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-7">
        {ubicacion.map((element) => (
          <CardMap map={element.map} title={element.title} />
        ))}
      </div>
    </div>
  </main>
</Layout>
